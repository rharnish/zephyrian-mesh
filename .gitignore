# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# config file with API keys (src/user-config-template.json is the
# committed placeholder — only the real, filled-in file is ignored)
src/user-config.json

# points at your own local ERA5 file by name (wind_source_template.json is
# the committed placeholder — only the real, filled-in file is ignored)
weather-data-server/wind_source.json

# Raw ERA5 wind data (hundreds of MB to ~1GB of .nc/.grib files) — too large
# for git, not source-controllable. wind_backend.py reads from here; see
# weather-data-server/README.md for how to obtain it.
weather-data-server/data/

node_modules
dist
dist-ssr
*.local

# Rust build artifacts
target

# Python venv + bytecode
.venv
__pycache__
*.pyc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# connectivity sweep results
experiments/results*/*json
experiments/results*/*log
experiments/legacy-js/results*/*json
experiments/legacy-js/results*/*log

# protocol sweep raw results
experiments/protocol-results/json/*json


# Cached wind fields — ~150MB per entry, rebuildable from weather-data-server
# via `cargo run --release --bin wind_cache -- fetch`. The manifests next to
# them record exactly which .nc and time step each came from, so a cache can
# be reconstructed rather than needing to be shared.
sim-server/.wind-cache/

# Untracked working notes (NEXT-STEPS.local.md and friends) — scratch, not
# documentation. Anything worth keeping graduates into docs/ or experiments/.
*.local.md
